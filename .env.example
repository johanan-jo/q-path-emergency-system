# Q-Path Configuration
# Copy to .env and customize as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# API Keys (Optional - using simulated data if not provided)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Optimization Parameters
MAX_QAOA_ITERATIONS=50
MAX_SA_ITERATIONS=1000
QAOA_LAYERS=1

# Graph Parameters
DEFAULT_TRAFFIC_MULTIPLIER=1.5
DEFAULT_WEATHER_MULTIPLIER=1.2
